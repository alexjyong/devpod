{
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "category": "DeveloperTool",
    "copyright": "",
    "externalBin": [
      "bin/devpod-secrets-cli",
      "bin/devpod-secrets-cli-linux-amd64",
      "bin/devpod-secrets-cli-linux-arm64"
    ],
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "DevPod with secrets management (BETA BUILD)",
    "longDescription": "Dev-environments-as-code like Terraform but for dev environments. Like Codespaces but open-source, client-only and unopinionated: Works with any IDE and lets you use any cloud, kubernetes or just on localhost docker.",
    "targets": "all",
    "macOS": {
      "entitlements": "./entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 160
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 160
        }
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": false
  },
  "productName": "DevPod Secrets",
  "mainBinaryName": "DevPod Secrets Desktop",
  "version": "../package.json",
  "identifier": "sh.loft.devpod.secrets",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "DevPod Secrets",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "x": 0,
        "y": 0,
        "focus": false,
        "titleBarStyle": "Overlay",
        "fullscreen": false,
        "resizable": true,
        "hiddenTitle": true,
        "transparent": true,
        "visible": false
      }
    ]
  }
}
